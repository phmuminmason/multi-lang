@startuml

Title Letter Grade Calculation

start

:Receive average grade; 

:Average Grade % 10;
:Y; <<object>>

:(Average Grade - Y) / 10;
:X; <<object>>

split
	if (X < 6?) then (yes)
		:X = 8;
	endif

	:X -= 10;
	:X + ""ASCII_OFFSET"" (64);
	:LetterGrade; <<object>>
split again
	if (Value of Y?) then (Y < 4)
		:Sign is "-";
	else if (Y < 7) then
		:Sign is " ";
	else (Y >= 7)
		:Sign is "+";
	endif
	:Sign; <<object>>
end split

:LetterGrade and Sign; <<object>>

@enduml
